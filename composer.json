{
    "name": "owner888/sanguohanjiang",
    "description": "Modern high-performance Three Kingdoms game server built with Workerman 5 and modern PHP 8.4+",
    "version": "1.4.0",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "workerman/workerman": "^5.1",
        "omniphp/framework": "dev-main || ^0.4"
    },
    "autoload": {
        "psr-4": {
            "Hanjiang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hanjiang\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/owner888/omniphp.git"
        }
    ]
}
