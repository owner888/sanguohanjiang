{
    "name": "owner888/sanguohanjiang",
    "description": "Modern high-performance Three Kingdoms game server built with Workerman 5 and modern PHP 8.4+",
    "version": "1.4.0",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "workerman/workerman": "^5.1",
        "omniphp/framework": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "Hanjiang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hanjiang\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "phpunit",
        "server:start": "php server.php start",
        "server:daemon": "php server.php start -d",
        "server:reload": "php server.php reload",
        "server:restart": "php server.php restart -d",
        "server:stop": "php server.php stop",
        "server:status": "php server.php status"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/owner888/omniphp.git"
        }
    ]
}
